{
  "name": "Alyassir demo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/alyassir",
  "postCreateCommand": "bash tooling/demo/setup.sh",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Alyassir",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postAttachCommand": "bash tooling/demo/start.sh"
}
